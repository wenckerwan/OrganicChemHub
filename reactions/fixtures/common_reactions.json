  {"model": "reactions.reaction", "pk": 107, "fields": {"name_zh": "狄尔斯-阿尔德反应", "name_en": "Diels-Alder Reaction", "slug": "common-diels-alder-reaction", "aliases": "Diels Alder cycloaddition", "reaction_type": 101, "tags": [101, 102, 103], "functional_groups": [], "equation_smiles": "C=CC=C.C=C>>C1C=CCCC1", "summary": "共轭二烯与亲双烯体发生[4+2]环加成生成六元环。", "condition": "加热或 Lewis 酸催化。", "mechanism": "协同周环反应。", "scope": "常用于构建环己烯骨架。", "limitations": "二烯构象和亲双烯体电子效应影响反应。", "exam_tips": "常考立体专一性和内型产物。", "reference": "周环反应章节。", "status": "published", "created_at": "2026-07-28T00:00:00Z", "updated_at": "2026-07-28T00:00:00Z"}},
  {"model": "reactions.reaction", "pk": 108, "fields": {"name_zh": "拜耳-维立格氧化", "name_en": "Baeyer-Villiger Oxidation", "slug": "common-baeyer-villiger-oxidation", "aliases": "Baeyer Villiger oxidation", "reaction_type": 102, "tags": [101, 102, 103], "functional_groups": [101], "equation_smiles": "CC(=O)C.OO>>CC(=O)OC", "summary": "酮被过酸氧化为酯，环酮可扩环生成内酯。", "condition": "常用过酸如 mCPBA。", "mechanism": "过酸加成后发生迁移并断裂。", "scope": "酮到酯或内酯的转化。", "limitations": "迁移能力和底物结构影响产物。", "exam_tips": "常考迁移基团选择。", "reference": "氧化反应章节。", "status": "published", "created_at": "2026-07-28T00:00:00Z", "updated_at": "2026-07-28T00:00:00Z"}},
