  {"model": "reactions.reaction", "pk": 101, "fields": {"name_zh": "维蒂希反应", "name_en": "Wittig Reaction", "slug": "common-wittig-reaction", "aliases": "Wittig olefination", "reaction_type": 101, "tags": [101, 102], "functional_groups": [101], "equation_smiles": "C=O.CPPh3>>C=C", "summary": "醛或酮与膦叶立德反应生成烯烃。", "condition": "膦盐在强碱作用下生成叶立德，再与醛酮反应。", "mechanism": "叶立德进攻羰基，经过含磷中间体后生成烯烃。", "scope": "常用于羰基化合物向烯烃转化。", "limitations": "E/Z 选择性受叶立德稳定性和底物影响。", "exam_tips": "注意膦叶立德来源和副产物三苯基氧膦。", "reference": "基础有机化学教材人名反应章节。", "status": "published", "created_at": "2026-07-28T00:00:00Z", "updated_at": "2026-07-28T00:00:00Z"}},
