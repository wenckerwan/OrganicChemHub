  {"model": "reactions.reaction", "pk": 104, "fields": {"name_zh": "羟醛缩合", "name_en": "Aldol Reaction", "slug": "common-aldol-reaction", "aliases": "Aldol addition; Aldol condensation", "reaction_type": 101, "tags": [101, 102, 103], "functional_groups": [101], "equation_smiles": "CC=O.CC=O>>CC(O)CC=O", "summary": "含α氢的醛酮在碱或酸催化下形成β-羟基羰基化合物，可进一步脱水。", "condition": "稀碱或酸催化。", "mechanism": "烯醇或烯醇负离子进攻另一分子羰基。", "scope": "用于碳碳键形成和羰基化合物合成。", "limitations": "混合羟醛可能产生复杂产物。", "exam_tips": "常考α氢、烯醇负离子和脱水产物。", "reference": "羰基化学章节。", "status": "published", "created_at": "2026-07-28T00:00:00Z", "updated_at": "2026-07-28T00:00:00Z"}},
  {"model": "reactions.reaction", "pk": 105, "fields": {"name_zh": "康尼扎罗反应", "name_en": "Cannizzaro Reaction", "slug": "common-cannizzaro-reaction", "aliases": "Cannizzaro disproportionation", "reaction_type": 102, "tags": [101, 102, 103], "functional_groups": [101], "equation_smiles": "O=CC1=CC=CC=C1.O=CC1=CC=CC=C1>>O=C(O)C1=CC=CC=C1.OCC1=CC=CC=C1", "summary": "无α氢醛在浓碱中发生歧化，生成羧酸盐和醇。", "condition": "浓 NaOH 或 KOH。", "mechanism": "氢负离子迁移导致一分子被氧化、另一分子被还原。", "scope": "适用于无α氢醛。", "limitations": "有α氢醛更倾向羟醛反应。", "exam_tips": "判断是否有α氢是关键。", "reference": "醛酮反应章节。", "status": "published", "created_at": "2026-07-28T00:00:00Z", "updated_at": "2026-07-28T00:00:00Z"}},
