# Copy this file to /www/wwwroot/chem.wencker.top/.env on the server.
# Replace DJANGO_SECRET_KEY before the first production start.

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=chem.wencker.top,www.chem.wencker.top,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://chem.wencker.top,http://chem.wencker.top
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret-key
